 "fields": [
  {
   "fieldname": "app_settings_tab",
   "fieldtype": "Tab Break",
   "label": "App Settings"
  },
  {
   "fieldname": "app_settings_section",
   "fieldtype": "Section Break",
   "label": "App Settings"
  },
  {
   "default": "0",
   "description": "Publish Android and iOS release state through flutter_utils.api.app_settings.get_app_config. While disabled, clients are always reported as up to date and available.",
   "fieldname": "enable_app_settings",
   "fieldtype": "Check",
   "label": "Enable App Settings"
  },
  {
   "description": "Identifier published with the app config. Use the same value clients send to flutter_utils.api.push_notifications.register_push_device.",
   "fieldname": "app_identifier",
   "fieldtype": "Data",
   "label": "Application Identifier",
   "mandatory_depends_on": "eval:doc.enable_app_settings"
  },
  {
   "description": "Shown to users on the update and unavailable screens.",
   "fieldname": "app_support_email",
   "fieldtype": "Data",
   "label": "Support Email",
   "options": "Email"
  },
  {
   "description": "Shown to users on the update and unavailable screens.",
   "fieldname": "app_support_url",
   "fieldtype": "Data",
   "label": "Support URL",
   "options": "URL"
  },
  {
   "fieldname": "android_section",
   "fieldtype": "Section Break",
   "label": "Android"
  },
  {
   "description": "Google Play listing opened by the client's update action.",
   "fieldname": "android_store_url",
   "fieldtype": "Data",
   "label": "Play Store URL",
   "options": "URL"
  },
  {
   "description": "Latest version published to the Play Store. Comparison is numeric per dot-separated part, so 1.10.0 is newer than 1.9.0.",
   "fieldname": "android_current_version",
   "fieldtype": "Data",
   "label": "Current Version",
   "mandatory_depends_on": "eval:doc.enable_app_settings"
  },
  {
   "fieldname": "column_break_android",
   "fieldtype": "Column Break"
  },
  {
   "description": "Oldest version allowed to keep using the app. Older clients are reported as update_required. Leave empty to only report update_available.",
   "fieldname": "android_minimum_version",
   "fieldtype": "Data",
   "label": "Minimum Version"
  },
  {
   "default": "0",
   "description": "Clients below the minimum version should show a non-dismissable update screen instead of a dismissable prompt.",
   "fieldname": "android_force_update",
   "fieldtype": "Check",
   "label": "Force Update"
  },
  {
   "default": "0",
   "description": "Report Android clients as unavailable so they show a maintenance screen. Advisory only; the server keeps serving every API.",
   "fieldname": "android_unavailable",
   "fieldtype": "Check",
   "label": "Temporarily Unavailable"
  },
  {
   "description": "Message shown on the maintenance screen. A default message is used when this is empty.",
   "fieldname": "android_unavailable_message",
   "fieldtype": "Small Text",
   "label": "Unavailable Message",
   "depends_on": "eval:doc.android_unavailable"
  },
  {
   "description": "Optional link to the changelog for the current version.",
   "fieldname": "android_release_notes_url",
   "fieldtype": "Data",
   "label": "Release Notes URL",
   "options": "URL"
  },
  {
   "fieldname": "android_released_on",
   "fieldtype": "Date",
   "label": "Released On"
  },
  {
   "fieldname": "ios_section",
   "fieldtype": "Section Break",
   "label": "iOS"
  },
  {
   "description": "App Store listing opened by the client's update action.",
   "fieldname": "ios_store_url",
   "fieldtype": "Data",
   "label": "App Store URL",
   "options": "URL"
  },
  {
   "description": "Latest version published to the App Store. Comparison is numeric per dot-separated part, so 1.10.0 is newer than 1.9.0.",
   "fieldname": "ios_current_version",
   "fieldtype": "Data",
   "label": "Current Version",
   "mandatory_depends_on": "eval:doc.enable_app_settings"
  },
  {
   "fieldname": "column_break_ios",
   "fieldtype": "Column Break"
  },
  {
   "description": "Oldest version allowed to keep using the app. Older clients are reported as update_required. Leave empty to only report update_available.",
   "fieldname": "ios_minimum_version",
   "fieldtype": "Data",
   "label": "Minimum Version"
  },
  {
   "default": "0",
   "description": "Clients below the minimum version should show a non-dismissable update screen instead of a dismissable prompt.",
   "fieldname": "ios_force_update",
   "fieldtype": "Check",
   "label": "Force Update"
  },
  {
   "default": "0",
   "description": "Report iOS clients as unavailable so they show a maintenance screen. Advisory only; the server keeps serving every API.",
   "fieldname": "ios_unavailable",
   "fieldtype": "Check",
   "label": "Temporarily Unavailable"
  },
  {
   "description": "Message shown on the maintenance screen. A default message is used when this is empty.",
   "fieldname": "ios_unavailable_message",
   "fieldtype": "Small Text",
   "label": "Unavailable Message",
   "depends_on": "eval:doc.ios_unavailable"
  },
  {
   "description": "Optional link to the changelog for the current version.",
   "fieldname": "ios_release_notes_url",
   "fieldtype": "Data",
   "label": "Release Notes URL",
   "options": "URL"
  },
  {
   "fieldname": "ios_released_on",
   "fieldtype": "Date",
   "label": "Released On"
  },
  {
   "fieldname": "authentication_tab",
   "fieldtype": "Tab Break",
   "label": "Authentication"
  },
  {
   "fieldname": "device_login_settings_section",
   "fieldtype": "Section Break",
   "label": "Device Login Settings"
  },
  {
   "default": "1",
   "description": "Maximum number of active API-token device logins allowed per user. A new login revokes the oldest active device when this limit is reached.",
   "fieldname": "maximum_logged_in_devices",
   "fieldtype": "Int",
   "label": "Maximum Logged-in Devices",
   "reqd": 1
  },
  {
   "fieldname": "otp_settings_section",
   "fieldtype": "Section Break",
   "label": "OTP Settings"
  },
  {
   "default": "1",
   "fieldname": "enable_email_otp",
   "fieldtype": "Check",
   "label": "Enable Email OTP"
  },
  {
   "default": "0",
   "fieldname": "enable_mobile_otp",
   "fieldtype": "Check",
   "label": "Enable Mobile OTP"
  },
  {
   "fieldname": "column_break_qpmo",
   "fieldtype": "Column Break"
  },
  {
   "default": "600",
   "description": "OTP expiry time in seconds.",
   "fieldname": "otp_ttl_seconds",
   "fieldtype": "Int",
   "label": "OTP TTL (Seconds)",
   "reqd": 1
  },
  {
   "default": "30",
   "description": "Cooldown period in seconds before a user can request another OTP.",
   "fieldname": "otp_resend_cooldown_seconds",
   "fieldtype": "Int",
   "label": "OTP Resend Cooldown (Seconds)",
   "reqd": 1
  },
  {
   "default": "4",
   "description": "Number of digits for generated OTPs. Usually 4 or 6.",
   "fieldname": "otp_length",
   "fieldtype": "Select",
   "label": "OTP Length",
   "reqd": 1,
   "options": "4\n6"
  },
  {
   "description": "Used when the client sends a phone number without country code.",
   "fieldname": "otp_default_region",
   "fieldtype": "Link",
   "label": "Default Region",
   "options": "Country"
  },
  {
   "default": "1",
   "description": "Skip SMS delivery and return OTP values directly from send APIs.",
   "fieldname": "test_mode",
   "fieldtype": "Check",
   "label": "Test Mode"
  },
  {
   "fieldname": "firebase_auth_section",
   "fieldtype": "Section Break",
   "label": "Firebase"
  },
  {
   "default": "0",
   "fieldname": "enable_firebase_auth",
   "fieldtype": "Check",
   "label": "Enable Firebase Authentication"
  },
  {
   "default": "0",
   "fieldname": "enable_firebase_push",
   "fieldtype": "Check",
   "label": "Enable Firebase Push"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_firebase_auth",
   "fieldname": "enable_firebase_phone_auth",
   "fieldtype": "Check",
   "label": "Enable Firebase Phone Auth"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_firebase_auth",
   "fieldname": "enable_firebase_google_auth",
   "fieldtype": "Check",
   "label": "Enable Firebase Google Auth"
  },
  {
   "fieldname": "column_break_firebase",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "depends_on": "eval:doc.enable_firebase_auth",
   "description": "Create a Website User when a verified Firebase identity does not match an existing user.",
   "fieldname": "firebase_auto_create_users",
   "fieldtype": "Check",
   "label": "Auto-create Website Users"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_firebase_auth",
   "description": "Disabled by default: Frappe controls account enabled status. Enable to also check Firebase token revocation and account disabled status, requiring an extra Firebase network request. Token signature and expiry are always verified.",
   "fieldname": "firebase_check_revoked_tokens",
   "fieldtype": "Check",
   "label": "Check Revoked Tokens"
  },
  {
   "depends_on": "eval:doc.enable_firebase_auth || doc.enable_firebase_push",
   "fieldname": "firebase_project_id",
   "fieldtype": "Data",
   "label": "Firebase Project ID",
   "mandatory_depends_on": "eval:doc.enable_firebase_auth || doc.enable_firebase_push"
  },
  {
   "depends_on": "eval:doc.enable_firebase_auth || doc.enable_firebase_push",
   "description": "Firebase Admin service-account JSON. Stored encrypted and never returned by public APIs.",
   "fieldname": "firebase_service_account_json",
   "fieldtype": "Password",
   "label": "Firebase Service Account JSON",
   "mandatory_depends_on": "eval:doc.enable_firebase_auth || doc.enable_firebase_push"
  },
  {
   "depends_on": "eval:doc.enable_firebase_auth",
   "fieldname": "test_firebase_connection",
   "fieldtype": "Button",
   "label": "Test Firebase Connection"
  },
  {
   "fieldname": "email_and_sms_tab",
   "fieldtype": "Tab Break",
   "label": "Email & SMS"
  },
  {
   "fieldname": "banner_settings_section",
   "fieldtype": "Section Break",
   "label": "Banner Settings"
  },
  {
   "description": "Used by flutter_utils.api.banners.get_banners when no slideshow is provided.",
   "fieldname": "default_banner_slideshow",
   "fieldtype": "Link",
   "label": "Default Banner Slideshow",
   "options": "Website Slideshow"
  },
  {
   "description": "Slideshow shown to members. Falls back to the default when empty.",
   "fieldname": "member_banner_slideshow",
   "fieldtype": "Link",
   "label": "Member Banner Slideshow",
   "options": "Website Slideshow"
  },
  {
   "description": "Slideshow shown to listeners. Falls back to the default when empty.",
   "fieldname": "listener_banner_slideshow",
   "fieldtype": "Link",
   "label": "Listener Banner Slideshow",
   "options": "Website Slideshow"
  },
  {
   "depends_on": "eval:doc.enable_email_otp",
   "fieldname": "email_section",
   "fieldtype": "Section Break",
   "label": "Email Content"
  },
  {
   "depends_on": "eval:doc.enable_email_otp",
   "fieldname": "email_otp_subject_template",
   "fieldtype": "Data",
   "label": "Email Subject Template"
  },
  {
   "depends_on": "eval:doc.enable_email_otp",
   "description": "Available placeholders: {{ app_name }}, {{ otp }}, {{ action }}, {{ expiry_minutes }}.",
   "fieldname": "email_otp_body_template",
   "fieldtype": "Text Editor",
   "label": "Email Body Template"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp",
   "fieldname": "twilio_section",
   "fieldtype": "Section Break",
   "label": "SMS Gateway"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp",
   "fieldname": "sms_gateway",
   "fieldtype": "Select",
   "label": "SMS Gateway",
   "mandatory_depends_on": "eval:doc.enable_mobile_otp",
   "options": "\nTwilio\nUltraMsg"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'Twilio'",
   "fieldname": "twilio_account_sid",
   "fieldtype": "Data",
   "label": "Twilio Account SID",
   "mandatory_depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'Twilio'"
  },
  {
   "fieldname": "column_break_gxji",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'Twilio'",
   "fieldname": "twilio_auth_token",
   "fieldtype": "Password",
   "label": "Twilio Auth Token",
   "mandatory_depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'Twilio'"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'Twilio'",
   "fieldname": "twilio_from_number",
   "fieldtype": "Data",
   "label": "Twilio From Number",
   "mandatory_depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'Twilio'"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'UltraMsg'",
   "description": "Defaults to https://api.ultramsg.com when left empty.",
   "fieldname": "ultramsg_base_url",
   "fieldtype": "Data",
   "label": "UltraMsg Base URL"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'UltraMsg'",
   "fieldname": "ultramsg_instance_id",
   "fieldtype": "Data",
   "label": "UltraMsg Instance ID",
   "mandatory_depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'UltraMsg'"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'UltraMsg'",
   "fieldname": "ultramsg_token",
   "fieldtype": "Password",
   "label": "UltraMsg Token",
   "mandatory_depends_on": "eval:doc.enable_mobile_otp && doc.sms_gateway === 'UltraMsg'"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp",
   "fieldname": "sms_content_section",
   "fieldtype": "Section Break",
   "label": "SMS Content"
  },
  {
   "depends_on": "eval:doc.enable_mobile_otp",
   "description": "Available placeholders: {{ app_name }}, {{ otp }}, {{ action }}, {{ expiry_minutes }}, {{ full_name }}.",
   "fieldname": "sms_otp_body_template",
   "fieldtype": "Small Text",
   "label": "SMS Body Template"
  },
  {
   "fieldname": "test_section",
   "fieldtype": "Section Break",
   "label": "Integration Test"
  },
  {
   "fieldname": "send_test_message",
   "fieldtype": "Button",
   "label": "Send Test Message"
  }
 ],
